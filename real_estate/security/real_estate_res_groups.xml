<odoo>
	<record id="category_real_estate" model="ir.module.category">
		<field name="name">Inmobiliaria</field>
		<field name="sequence">10</field>
	</record>
	<record id="privilege_real_estate" model="res.groups.privilege">
		<field name="name">Inmobiliaria</field>
		<field name="category_id" ref="category_real_estate"/>
	</record>
	<record id="group_property_manager" model="res.groups">
		<field name="name">manager de Propiedades</field>
		<field name="privilege_id" ref="privilege_real_estate"/>
		<!-- To add an existing user, uncomment this field and replace the ID:
		<field name="users" eval="[(4, ref('base.user_admin'))]"/>
		-->
	</record>
	<record id="group_property_seller" model="res.groups">
		<field name="name">Vendedor de Propiedades</field>
		<field name="privilege_id" ref="privilege_real_estate"/>
		<!-- To add an existing user, uncomment this field and replace the ID:
		<field name="users" eval="[(4, ref('base.user_admin'))]"/>
		-->
	</record>
</odoo>
